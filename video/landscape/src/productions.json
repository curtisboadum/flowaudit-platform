    "captions": [
      {
        "from": 0,
        "to": 79,
        "text": "When your front desk is busy, callers still need"
      },
      {
        "from": 79,
        "to": 97,
        "text": "an answer."
      },
      {
        "from": 109,
        "to": 195,
        "text": "Flow Audit is an AI phone agent configured around"
      },
      {
        "from": 195,
        "to": 298,
        "text": "your practice, supporting your team with agreed call workflows."
      },
      {
        "from": 307,
        "to": 394,
        "text": "This recorded demonstration uses Google Calendar."
      },
      {
        "from": 413,
        "to": 482,
        "text": "Listen to the appointment choices, then see the selected"
      },
      {
        "from": 482,
        "to": 494,
        "text": "booking."
      },
      {
        "from": 514,
        "to": 597,
        "text": "The recording includes privacy beeps and edited labels."
      },
      {
